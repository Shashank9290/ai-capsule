# Copy this file to .env (local dev) or set these as environment variables
# in your cloud platform's dashboard. Never commit real values.

PORT=5000
NODE_ENV=production

# Long random string used to sign/verify the application JWT
JWT_SECRET=replace_with_a_long_random_secret

# GitHub OAuth App credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_github_oauth_client_secret

# Must exactly match the "Authorization callback URL" configured on GitHub
GITHUB_CALLBACK_URL=https://YOUR-DEPLOYED-APP/api/auth/github/callback

# Public URL of the deployed app (used for CORS + post-login redirect)
CLIENT_URL=https://YOUR-DEPLOYED-APP
